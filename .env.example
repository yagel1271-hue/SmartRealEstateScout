# Copy this file to ".env" and fill in values. NEVER commit .env to Git.

# --- Business settings ---
# Separate multiple cities with ;
CITIES=פתח תקווה
BUDGET_MIN=1000000
BUDGET_MAX=1800000

# --- Schedule ---
TIMEZONE=Asia/Jerusalem
